#usda 1.0
(
    customLayerData = {
        string creator = "Detailed EPD540e from articulated Blender model"
        double groundLiftMeters = 0.1490000061988831
        string mechanismState = "stowed; Blender control scripts are not a Gearbox controller"
        int visualMeshCount = 1760
    }
    defaultPrim = "robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @oxbo_geom.usdc@
    ]
    upAxis = "Z"
)

over "robot" (
    apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:drive"]
    displayName = "Oxbo EPD540e - six wheel"
)
{
    custom string gearbox:asset:model = "EPD540e"
    custom string gearbox:asset:source = "/home/bresilla/OXBO_EPD540e_articulated.blend"
    rel gearbox:controller:drive:body = </robot/chassis>
    token gearbox:controller:drive:commandInterface = "cmd_vel"
    bool gearbox:controller:drive:enabled = 1
    token gearbox:controller:drive:frameConvention = "usd_z_up"
    float gearbox:controller:drive:frontLeftSteerDifferentialDeg = 2
    float gearbox:controller:drive:frontRightSteerDifferentialDeg = -2
    float gearbox:controller:drive:frontSteerMultiplier = 0.56
    float gearbox:controller:drive:frontTrackWidth = 2.43
    float gearbox:controller:drive:maxSteerDeg = 25
    float gearbox:controller:drive:middleSteerMultiplier = 0
    token gearbox:controller:drive:namespacePolicy = "machine_id"
    float gearbox:controller:drive:rearLeftSteerDifferentialDeg = -4
    float gearbox:controller:drive:rearRightSteerDifferentialDeg = 4
    float gearbox:controller:drive:rearSteerMultiplier = -1
    float gearbox:controller:drive:rearTrackWidth = 2.4
    token[] gearbox:controller:drive:stateInterfaces = ["pose", "velocity", "joint_state"]
    token gearbox:controller:drive:steeringGeometry = "six_wheel_ackermann"
    rel gearbox:controller:drive:target = </robot>
    float gearbox:controller:drive:trackWidth = 2.4
    token gearbox:controller:drive:type = "builtin:ackermann_cmd_vel"
    float gearbox:controller:drive:updateRateHz = 60
    token[] gearbox:controller:drive:usesRoles = ["poweredWheelJoints", "passiveWheelJoints", "steeringJoints"]
    float gearbox:controller:drive:wheelBase = 4.86
    float gearbox:controller:drive:wheelRadius = 0.69699997
    rel gearbox:machine:body = </robot/chassis>
    token gearbox:machine:idPolicy = "prim_path"
    token gearbox:machine:interfaceVersion = "0.1"
    token gearbox:machine:kind = "oxbo"
    rel gearbox:machine:role:passiveWheelJoints = [
        </robot/Joints/rev_front_left>,
        </robot/Joints/rev_front_right>,
        </robot/Joints/rev_middle_left>,
        </robot/Joints/rev_middle_right>,
    ]
    rel gearbox:machine:role:poweredWheelJoints = [
        </robot/Joints/rev_rear_left>,
        </robot/Joints/rev_rear_right>,
    ]
    rel gearbox:machine:role:steeringJoints = [
        </robot/Joints/steer_front_left>,
        </robot/Joints/steer_front_right>,
        </robot/Joints/steer_rear_left>,
        </robot/Joints/steer_rear_right>,
    ]
    token gearbox:machine:upAxis = "Z"
    double3 xformOp:translate = (0, 0, 0.1490000061988831)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "steer_front_left"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_front_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (1.215, -2.5, -1.1719999)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -16
            float physics:upperLimit = 16
        }

        def PhysicsRevoluteJoint "rev_front_left"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_front_left>
            rel physics:body1 = </robot/wheel_front_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "steer_front_right"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_front_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-1.215, -2.5, -1.1719999)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -16
            float physics:upperLimit = 16
        }

        def PhysicsRevoluteJoint "rev_front_right"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_front_right>
            rel physics:body1 = </robot/wheel_front_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rev_middle_left"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/wheel_middle_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (1.215, -0.9, -1.1719999)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rev_middle_right"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/wheel_middle_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-1.215, -0.9, -1.1719999)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "steer_rear_left"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_rear_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (1.2, 2.36, -1.252)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -29
            float physics:upperLimit = 29
        }

        def PhysicsRevoluteJoint "rev_rear_left"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_rear_left>
            rel physics:body1 = </robot/wheel_rear_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "steer_rear_right"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_rear_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-1.2, 2.36, -1.252)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -29
            float physics:upperLimit = 29
        }

        def PhysicsRevoluteJoint "rev_rear_right"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_rear_right>
            rel physics:body1 = </robot/wheel_rear_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, -0.35, -0.55)
        float3 physics:diagonalInertia = (22000, 72000, 76000)
        rel physics:filteredPairs = [
            </robot/wheel_front_left>,
            </robot/wheel_front_right>,
            </robot/wheel_middle_left>,
            </robot/wheel_middle_right>,
            </robot/wheel_rear_left>,
            </robot/wheel_rear_right>,
        ]
        float physics:mass = 15000

        def Mesh "collision_main" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-0.65, -3.2, -0.7), (0.65, -3.2, -0.7), (0.65, 3.2, -0.7), (-0.65, 3.2, -0.7), (-0.65, -3.2, 0.7), (0.65, -3.2, 0.7), (0.65, 3.2, 0.7), (-0.65, 3.2, 0.7)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }

        def Mesh "collision_upper" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-1.425, -3.75, 0.4), (1.425, -3.75, 0.4), (1.425, 3.75, 0.4), (-1.425, 3.75, 0.4), (-1.425, -3.75, 1.5), (1.425, -3.75, 1.5), (1.425, 3.75, 1.5), (-1.425, 3.75, 1.5)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }

        def Mesh "collision_header" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-1.9, -6.05, -1.3), (1.6, -6.05, -1.3), (1.6, -4.85, -1.3), (-1.9, -4.85, -1.3), (-1.9, -6.05, -0.7), (1.6, -6.05, -0.7), (1.6, -4.85, -0.7), (-1.9, -4.85, -0.7)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }
    }

    over "wheel_front_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.7279499173164368
            double radius = 0.7492750471591949
            token visibility = "invisible"
        }
    }

    over "wheel_front_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.7279499173164368
            double radius = 0.7492750471591949
            token visibility = "invisible"
        }
    }

    over "wheel_middle_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.7279499173164368
            double radius = 0.7492750471591949
            token visibility = "invisible"
        }
    }

    over "wheel_middle_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.7279499173164368
            double radius = 0.7492750471591949
            token visibility = "invisible"
        }
    }

    over "wheel_rear_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.690000057220459
            double radius = 0.6969999842643738
            token visibility = "invisible"
        }
    }

    over "wheel_rear_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (68, 38, 38)
        float physics:mass = 260

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.690000057220459
            double radius = 0.6969999842643738
            token visibility = "invisible"
        }
    }

    over "steer_front_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (4, 4, 4)
        float physics:mass = 60
    }

    over "steer_front_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (4, 4, 4)
        float physics:mass = 60
    }

    over "steer_rear_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (4, 4, 4)
        float physics:mass = 60
    }

    over "steer_rear_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (4, 4, 4)
        float physics:mass = 60
    }
}

def PhysicsScene "PhysicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}
