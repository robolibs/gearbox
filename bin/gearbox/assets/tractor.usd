#usda 1.0
(
    customLayerData = {
        string creator = "Fendt 300 Vario S4 Blender export"
        double groundLiftMeters = 0.01103192958831789
        string mechanisms = "closed static assemblies; stock tractor drive and steering roles"
        string sourceBlend = "/home/bresilla/Fendt_300_Vario_S4_detailed.blend"
    }
    defaultPrim = "robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @tractor_geom.usdc@
    ]
    upAxis = "Z"
)

over "robot" (
    apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:drive", "GearboxControllerAPI:pto"]
    displayName = "Fendt 300 Vario S4"
)
{
    rel gearbox:controller:drive:body = </robot/chassis>
    token gearbox:controller:drive:commandInterface = "cmd_vel"
    bool gearbox:controller:drive:enabled = 1
    token gearbox:controller:drive:frameConvention = "usd_z_up"
    float gearbox:controller:drive:frontTrackWidth = 1.882006
    float gearbox:controller:drive:maxSteerDeg = 45
    token gearbox:controller:drive:namespacePolicy = "machine_id"
    float gearbox:controller:drive:rearTrackWidth = 1.752
    token[] gearbox:controller:drive:stateInterfaces = ["pose", "velocity", "joint_state"]
    token gearbox:controller:drive:steeringGeometry = "parallel"
    rel gearbox:controller:drive:target = </robot>
    float gearbox:controller:drive:trackWidth = 1.752
    token gearbox:controller:drive:type = "builtin:ackermann_cmd_vel"
    float gearbox:controller:drive:updateRateHz = 60
    token[] gearbox:controller:drive:usesRoles = ["poweredWheelJoints", "steeringJoints"]
    float gearbox:controller:drive:wheelBase = 2.42091
    float gearbox:controller:drive:wheelRadius = 0.8466
    rel gearbox:machine:body = </robot/chassis>
    token gearbox:machine:idPolicy = "prim_path"
    token gearbox:machine:interfaceVersion = "0.1"
    token gearbox:machine:kind = "tractor"
    rel gearbox:machine:role:passiveWheelJoints = [
        </robot/Joints/rev_front_left>,
        </robot/Joints/rev_front_right>,
    ]
    rel gearbox:machine:role:poweredWheelJoints = [
        </robot/Joints/rev_back_left>,
        </robot/Joints/rev_back_right>,
    ]
    rel gearbox:machine:role:steeringJoints = [
        </robot/Joints/steer_front_left>,
        </robot/Joints/steer_front_right>,
    ]
    token gearbox:machine:upAxis = "Z"
    token[] gearbox:machine:grants = ["speed", "steering", "pto:pto"]
    bool gearbox:controller:pto:enabled = 1
    token gearbox:controller:pto:type = "builtin:pto"
    rel gearbox:controller:pto:target = </robot/Joints/pto_shaft>
    token gearbox:controller:pto:commandInterface = "pto"
    token[] gearbox:controller:pto:stateInterfaces = ["joint_state"]
    token gearbox:controller:pto:namespacePolicy = "machine_id"
    double3 xformOp:translate = (0, 0, 0.01103192958831789)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "pto_shaft"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/pto_stub>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 1.75, 0.7)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rev_back_left"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/wheel_back_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0.876, 0.9775999, 0.8356001)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rev_back_right"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/wheel_back_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-0.876, 0.97760296, 0.8355681)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "steer_front_left"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_front_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0.941012, -1.44331, 0.63112193)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsRevoluteJoint "rev_front_left"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_front_left>
            rel physics:body1 = </robot/wheel_front_left>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "steer_front_right"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/steer_front_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (-0.940994, -1.44331, 0.63112193)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }

        def PhysicsRevoluteJoint "rev_front_right"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </robot/steer_front_right>
            rel physics:body1 = </robot/wheel_front_right>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:name = "base_link"
        token gearbox:link:role = "base"

        def Xform "rear_three_point" (
            prepend apiSchemas = ["GearboxLinkAPI", "GearboxCouplingAPI"]
        )
        {
            token gearbox:link:role = "tool"
            token gearbox:coupling:side = "hitch"
            token gearbox:coupling:type = "three_point_mounted"
            token gearbox:coupling:name = "rear_three_point"
            int gearbox:coupling:isoCategory = 2
            double3 xformOp:translate = (0, 1.6, 0.6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "rear_hitch" (
            prepend apiSchemas = ["GearboxLinkAPI", "GearboxCouplingAPI"]
        )
        {
            token gearbox:link:role = "tool"
            token gearbox:coupling:side = "hitch"
            token gearbox:coupling:type = "drawbar"
            token gearbox:coupling:name = "rear_drawbar"
            double3 xformOp:translate = (0, 1.9, 0.45)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        point3f physics:centerOfMass = (0, -0.15, 0.85)
        vector3f physics:diagonalInertia = (1300, 850, 1450)
        rel physics:filteredPairs = [
            </robot/wheel_front_left>,
            </robot/wheel_front_right>,
            </robot/wheel_back_left>,
            </robot/wheel_back_right>,
            </robot/steer_front_left>,
            </robot/steer_front_right>,
        ]
        float physics:mass = 2000

        def Mesh "collision_lower" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-0.475, -2.1, 0.45), (0.475, -2.1, 0.45), (0.475, 1.5, 0.45), (-0.475, 1.5, 0.45), (-0.475, -2.1, 1.25), (0.475, -2.1, 1.25), (0.475, 1.5, 1.25), (-0.475, 1.5, 1.25)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }

        def Mesh "collision_cabin" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-0.775, -0.245, 1.225), (0.775, -0.245, 1.225), (0.775, 1.205, 1.225), (-0.775, 1.205, 1.225), (-0.775, -0.245, 2.875), (0.775, -0.245, 2.875), (0.775, 1.205, 2.875), (-0.775, 1.205, 2.875)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }

        def Mesh "collision_hood" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 4, 5, 6, 4, 6, 7, 0, 1, 5, 0, 5, 4, 1, 2, 6, 1, 6, 5, 2, 3, 7, 2, 7, 6, 3, 0, 4, 3, 4, 7]
            uniform token physics:approximation = "convexHull"
            point3f[] points = [(-0.525, -2.045, 0.875), (0.525, -2.045, 0.875), (0.525, -0.695, 0.875), (-0.525, -0.695, 0.875), (-0.525, -2.045, 1.725), (0.525, -2.045, 1.725), (0.525, -0.695, 1.725), (-0.525, -0.695, 1.725)]
            uniform token subdivisionScheme = "none"
            token visibility = "invisible"
        }
    }

    over "wheel_front_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "wheel"
        vector3f physics:diagonalInertia = (12, 7, 7)
        float physics:mass = 110

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.48
            double radius = 0.6408
            token visibility = "invisible"
        }
    }

    over "wheel_front_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "wheel"
        vector3f physics:diagonalInertia = (12, 7, 7)
        float physics:mass = 110

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.48
            double radius = 0.6408
            token visibility = "invisible"
        }
    }

    over "wheel_back_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "wheel"
        vector3f physics:diagonalInertia = (30, 18, 18)
        float physics:mass = 200

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.52
            double radius = 0.8466
            token visibility = "invisible"
        }
    }

    over "wheel_back_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "wheel"
        vector3f physics:diagonalInertia = (30, 18, 18)
        float physics:mass = 200

        def Cylinder "tire_collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.52
            double radius = 0.8466
            token visibility = "invisible"
        }
    }

    over "steer_front_left" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "steer"
        vector3f physics:diagonalInertia = (3, 3, 3)
        float physics:mass = 50
    }

    over "steer_front_right" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "steer"
        vector3f physics:diagonalInertia = (3, 3, 3)
        float physics:mass = 50
    }
    def Xform "pto_stub" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "GearboxLinkAPI"]
    )
    {
        token gearbox:link:role = "tool"
        float physics:mass = 4
        vector3f physics:diagonalInertia = (0.02, 0.02, 0.02)
        double3 xformOp:translate = (0, 1.75, 0.7)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "shaft"
        {
            token axis = "Y"
            double radius = 0.02
            double height = 0.15
        }
    }
}

def PhysicsScene "PhysicsScene"
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}
