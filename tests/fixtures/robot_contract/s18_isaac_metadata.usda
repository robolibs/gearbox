#usda 1.0
(
    defaultPrim = "bot"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "bot" (prepend apiSchemas = ["IsaacRobotAPI", "PhysicsArticulationRootAPI"])
{
    rel isaac:physics:robotLinks = [</bot/base>, </bot/link1>]
    rel isaac:physics:robotJoints = [</bot/joints/j2>, </bot/joints/j1>]

    def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "IsaacLinkAPI"])
    {
        string isaac:nameOverride = "chassis_link"
    }
    def Xform "link1" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "link2" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
    {
        double3 xformOp:translate = (2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "tcp" (prepend apiSchemas = ["IsaacSiteAPI"])
        {
            double3 xformOp:translate = (0.2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Xform "link3" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
    {
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "joints"
    {
        def PhysicsRevoluteJoint "j1" (prepend apiSchemas = ["IsaacJointAPI"])
        {
            rel physics:body0 = </bot/base>
            rel physics:body1 = </bot/link1>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            string isaac:NameOverride = "shoulder"
            bool[] isaac:actuator = [true]
        }
        def PhysicsRevoluteJoint "j2" (prepend apiSchemas = ["IsaacJointAPI"])
        {
            rel physics:body0 = </bot/link1>
            rel physics:body1 = </bot/link2>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            bool[] isaac:actuator = [false]
        }
        def PhysicsJoint "j3" (
            prepend apiSchemas = ["IsaacJointAPI", "PhysicsLimitAPI:transX", "PhysicsLimitAPI:transY", "PhysicsLimitAPI:transZ", "PhysicsLimitAPI:rotY"]
        )
        {
            rel physics:body0 = </bot/link2>
            rel physics:body1 = </bot/link3>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            float limit:transX:physics:low = 1
            float limit:transX:physics:high = -1
            float limit:transY:physics:low = 1
            float limit:transY:physics:high = -1
            float limit:transZ:physics:low = 1
            float limit:transZ:physics:high = -1
            float limit:rotY:physics:low = 1
            float limit:rotY:physics:high = -1
            token[] isaac:physics:DofOffsetOpOrder = ["RotZ", "RotX"]
            bool[] isaac:actuator = [true, false]
        }
    }
}
