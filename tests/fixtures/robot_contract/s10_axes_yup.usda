#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Robot" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 3, -2)
            float xformOp:rotateY = 90
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 4, -2)
            float xformOp:rotateY = 135
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
        }
        def PhysicsRevoluteJoint "yaw"
        {
            rel physics:body0 = </World/Robot/base>
            rel physics:body1 = </World/Robot/link>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0.5, 0)
            point3f physics:localPos1 = (0, -0.5, 0)
        }
    }
}
