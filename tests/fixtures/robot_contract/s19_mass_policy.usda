#usda 1.0
(
    defaultPrim = "heavy"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "heavy" (prepend apiSchemas = ["GearboxMachineAPI"])
{
    rel gearbox:machine:body = </heavy/chassis>

    def Xform "chassis" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 3800
        float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)

        def Cube "hull" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"])
        {
            double size = 2
            float physics:density = 1000
        }
    }
}
