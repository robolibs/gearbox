#usda 1.0
(
    defaultPrim = "broken"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "broken" (prepend apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:brain"])
{
    rel gearbox:machine:body = </broken/base>
    token gearbox:controller:brain:type = "external:process"
    string gearbox:controller:brain:executable = "/bin/sh"
    string[] gearbox:controller:brain:args = ["-c", "true"]

    def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 5
        float3 physics:diagonalInertia = (1, 1, 1)
    }
    def Xform "arm" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 1
        float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def PhysicsRevoluteJoint "lift" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
    {
        rel physics:body0 = </broken/base>
        rel physics:body1 = </broken/arm>
        point3f physics:localPos0 = (0.5, 0, 0)
        point3f physics:localPos1 = (-0.5, 0, 0)
        float drive:angular:physics:stiffness = 10
        float gearbox:motor:maxForce = 50
    }
    def PhysicsRevoluteJoint "dangling"
    {
        rel physics:body0 = </broken/base>
        rel physics:body1 = </broken/missing_link>
    }
}
