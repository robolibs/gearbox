#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Robot" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 2
            float3 physics:diagonalInertia = (0.1, 0.2, 0.3)
            point3f physics:centerOfMass = (0.1, 0, 0)
            vector3f physics:velocity = (1, 0, 0)
            vector3f physics:angularVelocity = (0, 0, 90)
        }
        def Xform "arm" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "slider" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 0.5
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "hinge" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
        {
            rel physics:body0 = </World/Robot/base>
            rel physics:body1 = </World/Robot/arm>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:stiffness = 1.7453292519943295
            float drive:angular:physics:damping = 0.17453292519943295
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:targetPosition = 30
            float drive:angular:physics:targetVelocity = 9
        }
        def PhysicsPrismaticJoint "slide" (prepend apiSchemas = ["PhysicsDriveAPI:linear"])
        {
            rel physics:body0 = </World/Robot/arm>
            rel physics:body1 = </World/Robot/slider>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            float physics:lowerLimit = -0.5
            float physics:upperLimit = 0.5
            float drive:linear:physics:stiffness = 1000
            float drive:linear:physics:damping = 100
            float drive:linear:physics:maxForce = 200
            float drive:linear:physics:targetPosition = 0.25
            float drive:linear:physics:targetVelocity = 0.1
        }
    }
}
