#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Floater" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float physics:mass = 2
        float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
        double3 xformOp:translate = (0, 0, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Arm" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 5
            float3 physics:diagonalInertia = (0.2, 0.2, 0.2)
        }
        def Xform "link1" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.05, 0.05, 0.01)
            double3 xformOp:translate = (0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "link2" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.05, 0.05, 0.01)
            double3 xformOp:translate = (0, 0, 2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsFixedJoint "anchor"
        {
            rel physics:body1 = </World/Arm/base>
        }
        def PhysicsRevoluteJoint "shoulder"
        {
            rel physics:body0 = </World/Arm/base>
            rel physics:body1 = </World/Arm/link1>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 0.5)
            point3f physics:localPos1 = (0, 0, -0.5)
            float physics:lowerLimit = -90
            float physics:upperLimit = 90
        }
        def PhysicsRevoluteJoint "elbow"
        {
            rel physics:body0 = </World/Arm/link1>
            rel physics:body1 = </World/Arm/link2>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 0.5)
            point3f physics:localPos1 = (0, 0, -0.5)
        }
    }

    def Xform "Branch" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Xform "torso" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 10
            float3 physics:diagonalInertia = (1, 1, 1)
            double3 xformOp:translate = (5, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "left" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.05, 0.05, 0.05)
            double3 xformOp:translate = (5, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "right" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.05, 0.05, 0.05)
            double3 xformOp:translate = (5, -1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "finger" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 0.2
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (5, 1.5, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "left_shoulder"
        {
            rel physics:body0 = </World/Branch/torso>
            rel physics:body1 = </World/Branch/left>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0, 0.5, 0)
            point3f physics:localPos1 = (0, -0.5, 0)
        }
        def PhysicsRevoluteJoint "right_shoulder"
        {
            rel physics:body0 = </World/Branch/torso>
            rel physics:body1 = </World/Branch/right>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (0, -0.5, 0)
            point3f physics:localPos1 = (0, 0.5, 0)
        }
        def PhysicsPrismaticJoint "grip"
        {
            rel physics:body0 = </World/Branch/left>
            rel physics:body1 = </World/Branch/finger>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0.25, 0)
            point3f physics:localPos1 = (0, -0.25, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.1
        }
    }
}
