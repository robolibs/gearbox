#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Bad" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "parked" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            active = false
        )
        {
        }
        def Xform "post"
        {
            double3 xformOp:translate = (0, 0, 2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "typo"
        {
            rel physics:body0 = </World/Bad/base>
            rel physics:body1 = </World/Bad/lnik>
        }
        def PhysicsRevoluteJoint "inactive"
        {
            rel physics:body0 = </World/Bad/base>
            rel physics:body1 = </World/Bad/parked>
        }
        def PhysicsRevoluteJoint "good"
        {
            rel physics:body0 = </World/Bad/base>
            rel physics:body1 = </World/Bad/link>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
        }
        def PhysicsFixedJoint "to_post"
        {
            rel physics:body0 = </World/Bad/post>
            rel physics:body1 = </World/Bad/base>
            point3f physics:localPos0 = (0, 0, -2)
        }
    }
}
