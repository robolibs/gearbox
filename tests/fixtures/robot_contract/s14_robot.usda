#usda 1.0
(
    defaultPrim = "robot"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "robot" (prepend apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:boom"])
{
    rel gearbox:machine:body = </robot/chassis>
    token gearbox:controller:boom:type = "builtin:joint_position"
    rel gearbox:controller:boom:target = </robot/Joints/lift>

    def Xform "chassis" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 10
        float3 physics:diagonalInertia = (1, 1, 1)
    }
    def Xform "boom" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 1
        float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Scope "Joints"
    {
        def PhysicsRevoluteJoint "lift" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
        {
            rel physics:body0 = </robot/chassis>
            rel physics:body1 = </robot/boom>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
            float drive:angular:physics:stiffness = 10
            float drive:angular:physics:damping = 1
            uniform token[] gearbox:joint:angular:commandInterfaces = ["position"]
        }
    }
}
