#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Limits" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
        }
        def Xform "a" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "b" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (-1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "c" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "d" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, -1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "lower_only"
        {
            rel physics:body0 = </World/Limits/base>
            rel physics:body1 = </World/Limits/a>
            point3f physics:localPos0 = (1, 0, 0)
            float physics:lowerLimit = -30
        }
        def PhysicsRevoluteJoint "continuous"
        {
            rel physics:body0 = </World/Limits/base>
            rel physics:body1 = </World/Limits/b>
            point3f physics:localPos0 = (-1, 0, 0)
        }
        def PhysicsRevoluteJoint "explicit_infinite"
        {
            rel physics:body0 = </World/Limits/base>
            rel physics:body1 = </World/Limits/c>
            point3f physics:localPos0 = (0, 1, 0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }
        def PhysicsPrismaticJoint "upper_only"
        {
            rel physics:body0 = </World/Limits/base>
            rel physics:body1 = </World/Limits/d>
            point3f physics:localPos0 = (0, -1, 0)
            float physics:upperLimit = 0.2
        }
    }
}
