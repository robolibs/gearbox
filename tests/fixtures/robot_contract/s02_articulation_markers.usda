#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "A" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "hinge"
        {
            rel physics:body0 = </World/A/base>
            rel physics:body1 = </World/A/link>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
        }
    }

    def Xform "B"
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"])
        {
            double3 xformOp:translate = (0, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "hinge"
        {
            rel physics:body0 = </World/B/base>
            rel physics:body1 = </World/B/link>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
        }
    }

    def Xform "C"
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsFixedJoint "anchor" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
        {
            rel physics:body1 = </World/C/base>
            point3f physics:localPos0 = (0, 6, 0)
        }
        def PhysicsRevoluteJoint "hinge"
        {
            rel physics:body0 = </World/C/base>
            rel physics:body1 = </World/C/link>
            point3f physics:localPos0 = (0.5, 0, 0)
            point3f physics:localPos1 = (-0.5, 0, 0)
        }
    }
}
