#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Welded" (prepend apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:roller"])
    {
        rel gearbox:machine:body = </World/Welded/body>
        token gearbox:controller:roller:type = "builtin:joint_velocity"
        bool gearbox:controller:roller:enabled = 0
        rel gearbox:controller:roller:target = </World/Welded/weld>
        def Xform "body" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "roller" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0.5, 9, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsFixedJoint "weld"
        {
            rel physics:body0 = </World/Welded/body>
            rel physics:body1 = </World/Welded/roller>
            point3f physics:localPos0 = (0.5, 0, 0)
        }
    }
    def Xform "Live" (prepend apiSchemas = ["GearboxMachineAPI", "GearboxControllerAPI:roller"])
    {
        rel gearbox:machine:body = </World/Live/body>
        token gearbox:controller:roller:type = "builtin:joint_velocity"
        bool gearbox:controller:roller:enabled = 1
        rel gearbox:controller:roller:target = </World/Live/weld>
        def Xform "body" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "roller" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0.5, 12, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsFixedJoint "weld"
        {
            rel physics:body0 = </World/Live/body>
            rel physics:body1 = </World/Live/roller>
            point3f physics:localPos0 = (0.5, 0, 0)
        }
    }
    def Xform "Numbers" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = -2
            float3 physics:diagonalInertia = (-1, 1, 1)
            double3 xformOp:translate = (0, 6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (1, 6, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "hinge" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
        {
            rel physics:body0 = </World/Numbers/base>
            rel physics:body1 = </World/Numbers/link>
            point3f physics:localPos0 = (inf, 0, 0)
            float drive:angular:physics:stiffness = -5
            float physics:lowerLimit = 10
            float physics:upperLimit = -10
        }
    }
}
