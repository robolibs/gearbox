#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "P0" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "bob" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "pivot"
        {
            rel physics:body1 = </World/P0/bob>
            uniform token physics:axis = "Y"
            point3f physics:localPos0 = (0, 0, 2)
            point3f physics:localPos1 = (0, 0, 1)
        }
    }

    def Xform "P1" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "bob" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1
            float3 physics:diagonalInertia = (0.01, 0.01, 0.01)
            double3 xformOp:translate = (3, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsPrismaticJoint "rail"
        {
            rel physics:body0 = </World/P1/bob>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (3, 0, 0.5)
            float physics:lowerLimit = -1
            float physics:upperLimit = 1
        }
    }
}
