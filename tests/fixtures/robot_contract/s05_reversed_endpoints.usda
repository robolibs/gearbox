#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "World"
{
    def Xform "Fwd" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 0, 0)
            float xformOp:rotateZ = 30
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
        def PhysicsRevoluteJoint "hinge"
        {
            rel physics:body0 = </World/Fwd/base>
            rel physics:body1 = </World/Fwd/link>
            uniform token physics:axis = "Z"
        }
    }

    def Xform "Rev"
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI"])
        {
            double3 xformOp:translate = (0, 5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
        {
            double3 xformOp:translate = (0, 5, 0)
            float xformOp:rotateZ = 30
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }
        def PhysicsRevoluteJoint "hinge"
        {
            rel physics:body0 = </World/Rev/link>
            rel physics:body1 = </World/Rev/base>
            uniform token physics:axis = "Z"
        }
    }
}
