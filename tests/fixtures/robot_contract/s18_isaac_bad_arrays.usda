#usda 1.0
(
    defaultPrim = "bot"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "bot" (prepend apiSchemas = ["IsaacRobotAPI", "PhysicsArticulationRootAPI"])
{
    rel isaac:physics:robotLinks = [</bot/base>, </bot/missing>]

    def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
    {
    }
    def Xform "link" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def PhysicsRevoluteJoint "j" (prepend apiSchemas = ["IsaacJointAPI"])
    {
        rel physics:body0 = </bot/base>
        rel physics:body1 = </bot/link>
        point3f physics:localPos0 = (0.5, 0, 0)
        point3f physics:localPos1 = (-0.5, 0, 0)
        bool[] isaac:actuator = [true, false]
    }
}
