#usda 1.0
(
    defaultPrim = "rover"
    upAxis = "Z"
    metersPerUnit = 1
    kilogramsPerUnit = 1
)

def Xform "rover" (prepend apiSchemas = ["GearboxMachineAPI"])
{
    rel gearbox:machine:body = </rover/chassis>
    rel gearbox:machine:baseFrame = </rover/chassis/base_footprint>
    rel gearbox:machine:controlFrame = </rover/chassis/control>

    def Xform "chassis" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
    {
        float physics:mass = 50
        float3 physics:diagonalInertia = (2, 3, 4)
        double3 xformOp:translate = (0, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "base_footprint"
        {
            double3 xformOp:translate = (0, 0, -0.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "control"
        {
            float xformOp:rotateZ = 90
            uniform token[] xformOpOrder = ["xformOp:rotateZ"]
        }
    }
}
