#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 0.01
    kilogramsPerUnit = 0.001
)

def Xform "World"
{
    def Xform "Robot" (prepend apiSchemas = ["PhysicsArticulationRootAPI"])
    {
        def Xform "base" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 2000
            float3 physics:diagonalInertia = (1000000, 2000000, 3000000)
            point3f physics:centerOfMass = (10, 0, 0)
            vector3f physics:velocity = (100, 0, 0)
            vector3f physics:angularVelocity = (0, 0, 90)
        }
        def Xform "arm" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 1000
            float3 physics:diagonalInertia = (100000, 100000, 100000)
            double3 xformOp:translate = (100, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "slider" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
        {
            float physics:mass = 500
            float3 physics:diagonalInertia = (10000, 10000, 10000)
            double3 xformOp:translate = (200, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def PhysicsRevoluteJoint "hinge" (prepend apiSchemas = ["PhysicsDriveAPI:angular"])
        {
            rel physics:body0 = </World/Robot/base>
            rel physics:body1 = </World/Robot/arm>
            uniform token physics:axis = "Z"
            point3f physics:localPos0 = (50, 0, 0)
            point3f physics:localPos1 = (-50, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
            float drive:angular:physics:stiffness = 17453292.519943295
            float drive:angular:physics:damping = 1745329.2519943295
            float drive:angular:physics:maxForce = 500000000
            float drive:angular:physics:targetPosition = 30
            float drive:angular:physics:targetVelocity = 9
        }
        def PhysicsPrismaticJoint "slide" (prepend apiSchemas = ["PhysicsDriveAPI:linear"])
        {
            rel physics:body0 = </World/Robot/arm>
            rel physics:body1 = </World/Robot/slider>
            uniform token physics:axis = "X"
            point3f physics:localPos0 = (50, 0, 0)
            point3f physics:localPos1 = (-50, 0, 0)
            float physics:lowerLimit = -50
            float physics:upperLimit = 50
            float drive:linear:physics:stiffness = 1000000
            float drive:linear:physics:damping = 100000
            float drive:linear:physics:maxForce = 20000000
            float drive:linear:physics:targetPosition = 25
            float drive:linear:physics:targetVelocity = 10
        }
    }
}
