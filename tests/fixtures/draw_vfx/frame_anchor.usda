#usda 1.0
(
    defaultPrim = "rig"
    upAxis = "Z"
    metersPerUnit = 1
)

def Xform "rig" (prepend apiSchemas = ["GearboxMachineAPI"])
{
    rel gearbox:machine:body = </rig/body>
    def Cube "body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI", "GearboxLinkAPI"])
    {
        token gearbox:link:role = "base"
        bool physics:kinematicEnabled = true
        float physics:mass = 1
        float3 physics:diagonalInertia = (1, 1, 1)
        double size = 0.3
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.3, 0.35, 0.4)]
    }
}
